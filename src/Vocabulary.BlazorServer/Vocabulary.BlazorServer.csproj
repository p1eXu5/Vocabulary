<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--<RazorLanguageVersion>7</RazorLanguageVersion>-->
    
    <Copyright>(c) 2022 Vladimir Likhatskiy (p1eXu5)</Copyright>
    <PackageProjectUrl>https://github.com/p1eXu5/Vocabulary</PackageProjectUrl>
    <RepositoryUrl>https://github.com/p1eXu5/Vocabulary</RepositoryUrl>
    <PackageTags>vocabulary, uml, specifications, technical documentation</PackageTags>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <UserSecretsId>bf60667f-d1da-431e-8d06-3975bc91ef40</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <NoWarn>CA1050;CA1816</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.6" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="MudBlazor" Version="8.9.0" />
    <PackageReference Include="MudBlazor.Markdown" Version="8.7.0" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.14.0" />
    <PackageReference Include="Seq.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vocabulary.Adapters\Vocabulary.Adapters.csproj" />
    <ProjectReference Include="..\Vocabulary\Vocabulary.csproj" />
  </ItemGroup>

</Project>
