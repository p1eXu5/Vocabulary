@using MudBlazor.Utilities
@implements IAsyncDisposable

@inject IJSRuntime JS

<style>
    .drawer-resize-handle {
        position: absolute;
        height: 100vh;
        top: 0px;
        z-index: 1000;
        transition: background 0.3s ease;
    }

    .drawer-resize-handle--opened {
        width: 3px;
        cursor: ew-resize;
        background: #4D4D5B;
    }

    .drawer-resize-handle--opened:hover {
        background: #7DE67F;
    }

    .drawer-resize-handle--closed {
        background: transparent;
    }

</style>

<div @ref="_handleRef"
     class="@Classname"
     style="@Stylename"
     @onmousedown="OnMouseDown"
     @onmouseover="() => _hover = true"
     @onmouseout="() => _hover = false">
</div>

@code {
    private ElementReference _handleRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GridSplitter>? _dotNetRef;
    private bool _hover = false;
    private bool _resizing = false;
    private double _startX;
    private double _startWidth;

    [CascadingParameter]
    public VocabularyMudTheme? VocabularyTheme { get; set; }

    [Parameter]
    public bool IsOpen { private get; set; }

    protected string Classname =>
        new CssBuilder("drawer-resize-handle")
            .AddClass("drawer-resize-handle--opened", IsOpen)
            .AddClass("drawer-resize-handle--closed", !IsOpen)
            .Build();

    protected string Stylename =>
        new StyleBuilder()
            .AddStyle("left", VocabularyTheme?.LayoutProperties.DrawerWidthLeft ?? VocabularyMudTheme.DRAWER_WIDTH_LEFT + "px", IsOpen)
            .AddStyle("left", "-3px", !IsOpen)
            .Build();

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Shared/Components/GridSplitter.razor.js");
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }

    private async Task OnMouseDown(MouseEventArgs e)
    {
        if (!IsOpen)
        {
            return; // Do not allow resizing when the drawer is closed
        }

        _resizing = true;
        _startX = e.ClientX;
        _startWidth = VocabularyTheme?.DrawerWidthLeft ?? VocabularyMudTheme.DRAWER_WIDTH_LEFT;

        await _module!.InvokeVoidAsync("register", _dotNetRef);
    }

    [JSInvokable]
    public void OnMouseMove(double clientX)
    {
        if (!_resizing || VocabularyTheme is null) return;
        var delta = clientX - _startX;
        var newWidth = Math.Max(180, Math.Min(400, _startWidth + delta)); // min/max width
        VocabularyTheme.DrawerWidthLeft = (int)newWidth;

        StateHasChanged();
        return;
    }

    [JSInvokable]
    public async Task OnMouseUp()
    {
        _resizing = false;
        await JS.InvokeVoidAsync("unregister");
    }
}
