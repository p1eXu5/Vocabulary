@implements IAsyncDisposable

@inject IJSRuntime JS

<div @ref="_handleRef"
     class="drawer-resize-handle"
     @onmousedown="OnMouseDown"
     style="width:3px; height: 100%; cursor:ew-resize; background:@(_hover ? "#1976d2" : "red"); transition: background 0.2s;"
     @onmouseover="() => _hover = true"
     @onmouseout="() => _hover = false">
</div>

@code {
    private ElementReference _handleRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<GridSplitter>? _dotNetRef;
    private bool _hover = false;
    private bool _resizing = false;
    private double _startX;
    private double _startWidth;

    // [CascadingParameter]
    // MudTheme Theme { get; set; }
    // 
    // [Parameter] public EventCallback<string> DrawerWidthChanged { get; set; }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./Shared/Components/GridSplitter.razor.js");
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
    }

    private async Task OnMouseDown(MouseEventArgs e)
    {
        _resizing = true;
        _startX = e.ClientX;
        _startWidth = ParsePx(/*Theme.LayoutProperties.DrawerWidthLeft*/"");

        await _module!.InvokeVoidAsync("register", _dotNetRef);
    }

    [JSInvokable]
    public Task OnMouseMove(double clientX)
    {
        // if (!_resizing) return;
        // var delta = clientX - _startX;
        // var newWidth = Math.Max(180, Math.Min(400, _startWidth + delta)); // min/max width
        // Theme.LayoutProperties.DrawerWidthLeft = $"{newWidth}px";
        // await DrawerWidthChanged.InvokeAsync(Theme.LayoutProperties.DrawerWidthLeft);
        // StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnMouseUp()
    {
        return Task.CompletedTask;
        // _resizing = false;
        // await JS.InvokeVoidAsync("mudDrawerResize.unregister");
    }

    private double ParsePx(string px)
    {
        if (px.EndsWith("px") && double.TryParse(px.Replace("px", ""), out var val))
        {
            return val;
        }
        return 240;
    }
}
