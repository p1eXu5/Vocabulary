@using Vocabulary.Adapters.Persistance.Models

<style>
    .out-trimmed-text {
        white-space: nowrap; /* Prevent text from wrapping to the next line */
        overflow: hidden; /* Hide the overflowing text */
        text-overflow: ellipsis; /* Show ellipsis (...) when text is truncated */
        width: calc(var(--mud-drawer-width-left) - 58px);
        display: block;
    }
    .trimmed-text {
        white-space: nowrap; /* Prevent text from wrapping to the next line */
        overflow: hidden; /* Hide the overflowing text */
        text-overflow: ellipsis; /* Show ellipsis (...) when text is truncated */
        width: calc(var(--mud-drawer-width-left) - 70px);
        display: block;
    }
</style>

<MudNavLink Href="@Href" Match="NavLinkMatch.Prefix">
    <MudText Typo="Typo.subtitle1" class="out-trimmed-text">@Term.Name</MudText>
    @if (!string.IsNullOrWhiteSpace(Term.AdditionalName)) {
        <div class="ml-3">
            <MudText Typo="Typo.caption" class="trimmed-text">@Term.AdditionalName</MudText>
        </div>
    }
</MudNavLink>


@code {
    [Parameter, EditorRequired]
    public string Href { private get; set; } = default!;

    [Parameter, EditorRequired]
    public Term Term { private get; set; } = default!;

    private string? LinkContent { get; set; }
}